generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum RetirementRequestStatus {
  PENDING_REVIEW
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  ASSET_MANAGER
  TECHNICIAN
  SOFTWARE_LICENSE_MANAGER
  PROCUREMENT_FINANCE
  MANAGER_APPROVER
  EMPLOYEE
  AUDITOR
}

enum AssetLifecycle {
  RECEIVED
  ACTIVE
  RETIRED
  DISPOSED
}

enum AssetAvailability {
  AVAILABLE
  RESERVED
  ASSIGNED
  IN_TRANSIT
  IN_REPAIR
  QUARANTINED
  UNAVAILABLE
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  NONFUNCTIONAL
  UNKNOWN
}

enum AssetVerification {
  VERIFIED
  MISSING
  DISPUTED
  NOT_CHECKED
}

enum AssetCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AssetTrackingMode {
  INDIVIDUAL
  QUANTITY
}

enum StockMovementType {
  RECEIPT
  ISSUE
  RETURN
  TRANSFER
}

enum AssetImportStatus {
  UPLOADED
  VALIDATING
  PREVIEW_READY
  FAILED
  COMMITTING
  COMMITTED
}

enum AssetHistoryEventType {
  REGISTERED
  COMMISSIONED
  PROFILE_UPDATED
  RELATIONSHIP_ADDED
  RELATIONSHIP_REMOVED
  RESERVATION_CREATED
  RESERVATION_CANCELLED
  ASSIGNED
  RETURNED
  TRANSFER_DISPATCHED
  TRANSFER_RECEIVED
  TRANSFER_EXCEPTION
  COMPONENT_INSTALLED
  COMPONENT_REMOVED
  VERIFICATION_RECONCILED
  RETIREMENT_REQUESTED
}

enum VerificationCampaignStatus {
  OPEN
  COMPLETED
}

enum VerificationObservationResult {
  VERIFIED
  MISSING
  MISPLACED
  TAG_MISMATCH
  DAMAGED
  DISPUTED
  UNEXPECTED
  DUPLICATE
}

enum VerificationObservationResolution {
  PENDING
  RECONCILED
  DISMISSED
}

enum AssignmentRecipientType {
  EMPLOYEE
  TEAM
  SHARED_POOL
}

enum AssetTransferStatus {
  DRAFT
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AssetTransferLineStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  MISSING
  REJECTED
  CANCELLED
}

enum SoftwareCommercialClassification {
  COMMERCIAL
  OPEN_SOURCE
  FREEWARE
  CUSTOM
  OTHER
}

enum SoftwarePolicyStatus {
  REVIEW_REQUIRED
  APPROVED
  PROHIBITED
}

model Organization {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(150)
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                  User[]
  sessions               RefreshSession[]
  locations              Location[]
  stores                 Store[]
  assetCategories        AssetCategory[]
  assets                 Asset[]
  departments            Department[]
  costCenters            CostCenter[]
  softwareProducts       SoftwareProduct[]
  manufacturers          Manufacturer[]
  assetModels            AssetModel[]
  employees              Employee[]
  assetHistory           AssetHistoryEvent[]
  assetRelationships     AssetRelationship[]
  assetReservations      AssetReservation[]
  assetAssignments       AssetAssignment[]
  assetReturns           AssetReturn[]
  assetTransfers         AssetTransfer[]
  assetTransferLines     AssetTransferLine[]
  stockItems             StockItem[]
  stockMovements         StockMovement[]
  stockReservations      StockReservation[]
  assetImportJobs        AssetImportJob[]
  assetImportErrors      AssetImportRowError[]
  componentInstallations ComponentInstallation[]
  verificationCampaigns  VerificationCampaign[]
  verificationCampaignAssets VerificationCampaignAsset[]
  verificationObservations VerificationObservation[]
  retirementRequests RetirementRequest[]

  @@map("organizations")
}

model User {
  id                         String                  @id @default(uuid()) @db.Uuid
  organizationId             String                  @map("organization_id") @db.Uuid
  email                      String                  @db.VarChar(254)
  displayName                String                  @map("display_name") @db.VarChar(160)
  passwordHash               String                  @map("password_hash") @db.VarChar(100)
  role                       UserRole                @default(EMPLOYEE)
  isActive                   Boolean                 @default(true) @map("is_active")
  mustChangePassword         Boolean                 @default(false) @map("must_change_password")
  version                    Int                     @default(1)
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization               Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions                   RefreshSession[]
  locationScopes             UserLocationScope[]     @relation("UserLocationScopeTarget")
  grantedLocationScopes      UserLocationScope[]     @relation("UserLocationScopeGrantor")
  revokedLocationScopes      UserLocationScope[]     @relation("UserLocationScopeRevoker")
  registeredAssets           Asset[]
  assetHistoryEvents         AssetHistoryEvent[]
  createdAssetRelationships  AssetRelationship[]     @relation("AssetRelationshipCreatedBy")
  endedAssetRelationships    AssetRelationship[]     @relation("AssetRelationshipEndedBy")
  createdAssetReservations   AssetReservation[]      @relation("AssetReservationCreatedBy")
  cancelledAssetReservations AssetReservation[]      @relation("AssetReservationCancelledBy")
  issuedAssetAssignments     AssetAssignment[]       @relation("AssetAssignmentIssuer")
  receivedAssetReturns       AssetReturn[]           @relation("AssetReturnReceiver")
  createdAssetTransfers      AssetTransfer[]         @relation("AssetTransferRequester")
  receivedTransferLines      AssetTransferLine[]     @relation("AssetTransferReceiver")
  createdAssetImportJobs     AssetImportJob[]        @relation("AssetImportCreator")
  installedComponents        ComponentInstallation[] @relation("ComponentInstallationInstaller")
  removedComponents          ComponentInstallation[] @relation("ComponentInstallationRemover")
  stockMovements             StockMovement[]         @relation("StockMovementActor")
  createdStockItems          StockItem[]             @relation("StockItemCreator")
  createdStockReservations   StockReservation[]      @relation("StockReservationCreator")
  cancelledStockReservations StockReservation[]      @relation("StockReservationCanceller")
  createdVerificationCampaigns VerificationCampaign[] @relation("VerificationCampaignCreator")
  completedVerificationCampaigns VerificationCampaign[] @relation("VerificationCampaignCompleter")
  recordedVerificationObservations VerificationObservation[] @relation("VerificationObservationActor")
  reconciledVerificationObservations VerificationObservation[] @relation("VerificationObservationReconciler")
  submittedRetirementRequests RetirementRequest[] @relation("RetirementRequestSubmitter")

  @@unique([organizationId, email], map: "users_organization_id_email_key")
  @@unique([organizationId, id], map: "users_organization_id_id_key")
  @@index([organizationId, isActive], map: "users_organization_id_is_active_idx")
  @@map("users")
}

model Location {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  parentLocationId     String?             @map("parent_location_id") @db.Uuid
  code                 String              @db.VarChar(60)
  name                 String              @db.VarChar(150)
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent               Location?           @relation("LocationTree", fields: [organizationId, parentLocationId], references: [organizationId, id], onDelete: Restrict)
  children             Location[]          @relation("LocationTree")
  stores               Store[]
  scopeGrants          UserLocationScope[]
  assets               Asset[]
  sourceTransfers      AssetTransfer[]     @relation("AssetTransferSource")
  destinationTransfers AssetTransfer[]     @relation("AssetTransferDestination")
  verificationCampaigns VerificationCampaign[] @relation("VerificationCampaignLocation")
  expectedVerificationAssets VerificationCampaignAsset[] @relation("VerificationExpectedLocation")
  observedVerificationObservations VerificationObservation[] @relation("VerificationObservedLocation")

  @@unique([organizationId, id], map: "locations_organization_id_id_key")
  @@unique([organizationId, code], map: "locations_organization_id_code_key")
  @@index([organizationId, parentLocationId, isActive], map: "locations_org_parent_active_idx")
  @@map("locations")
}

model Store {
  id                        String             @id @default(uuid()) @db.Uuid
  organizationId            String             @map("organization_id") @db.Uuid
  locationId                String             @map("location_id") @db.Uuid
  code                      String             @db.VarChar(60)
  name                      String             @db.VarChar(150)
  isActive                  Boolean            @default(true) @map("is_active")
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  location                  Location           @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  sourceStockMovements      StockMovement[]    @relation("StockMovementSource")
  destinationStockMovements StockMovement[]    @relation("StockMovementDestination")
  stockReservations         StockReservation[]

  @@unique([organizationId, id], map: "stores_organization_id_id_key")
  @@unique([organizationId, code], map: "stores_organization_id_code_key")
  @@index([organizationId, locationId, isActive], map: "stores_org_location_active_idx")
  @@map("stores")
}

model UserLocationScope {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  locationId       String    @map("location_id") @db.Uuid
  assignedByUserId String    @map("assigned_by_user_id") @db.Uuid
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  user             User      @relation("UserLocationScopeTarget", fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  location         Location  @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  assignedBy       User      @relation("UserLocationScopeGrantor", fields: [organizationId, assignedByUserId], references: [organizationId, id], onDelete: Restrict)
  revokedBy        User?     @relation("UserLocationScopeRevoker", fields: [organizationId, revokedByUserId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, userId, revokedAt], map: "user_location_scopes_org_user_revoked_idx")
  @@index([organizationId, locationId, revokedAt], map: "user_location_scopes_org_location_revoked_idx")
  @@map("user_location_scopes")
}

model RefreshSession {
  id             String       @id @default(uuid()) @db.Uuid
  familyId       String       @map("family_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  tokenHash      String       @unique(map: "refresh_sessions_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  rotatedAt      DateTime?    @map("rotated_at") @db.Timestamptz(3)
  revokedAt      DateTime?    @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, userId, familyId], map: "refresh_sessions_org_user_family_idx")
  @@index([familyId, revokedAt], map: "refresh_sessions_family_revoked_idx")
  @@map("refresh_sessions")
}

model AssetCategory {
  id                  String            @id @default(uuid()) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  code                String            @db.VarChar(60)
  name                String            @db.VarChar(150)
  trackingMode        AssetTrackingMode @default(INDIVIDUAL) @map("tracking_mode")
  specificationFields Json              @default("[]") @map("specification_fields")
  isActive            Boolean           @default(true) @map("is_active")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assets              Asset[]
  stockItems          StockItem[]

  @@unique([organizationId, id], map: "asset_categories_organization_id_id_key")
  @@unique([organizationId, code], map: "asset_categories_organization_id_code_key")
  @@index([organizationId, isActive, code], map: "asset_categories_org_active_code_idx")
  @@map("asset_categories")
}

model StockItem {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  categoryId      String             @map("category_id") @db.Uuid
  code            String             @db.VarChar(60)
  name            String             @db.VarChar(150)
  description     String?            @db.VarChar(1000)
  createdByUserId String             @map("created_by_user_id") @db.Uuid
  isActive        Boolean            @default(true) @map("is_active")
  version         Int                @default(1)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category        AssetCategory      @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  createdBy       User               @relation("StockItemCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  movements       StockMovement[]
  reservations    StockReservation[]

  @@unique([organizationId, id], map: "stock_items_organization_id_id_key")
  @@unique([organizationId, code], map: "stock_items_org_code_key")
  @@index([organizationId, categoryId, isActive], map: "stock_items_org_category_active_idx")
  @@map("stock_items")
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  stockItemId        String            @map("stock_item_id") @db.Uuid
  movementType       StockMovementType @map("movement_type")
  sourceStoreId      String?           @map("source_store_id") @db.Uuid
  destinationStoreId String?           @map("destination_store_id") @db.Uuid
  quantity           Int
  reason             String            @db.VarChar(500)
  sourceReference    String?           @map("source_reference") @db.VarChar(150)
  createdByUserId    String            @map("created_by_user_id") @db.Uuid
  idempotencyKey     String            @map("idempotency_key") @db.VarChar(100)
  payloadHash        String            @map("payload_hash") @db.Char(64)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockItem          StockItem         @relation(fields: [organizationId, stockItemId], references: [organizationId, id], onDelete: Restrict)
  sourceStore        Store?            @relation("StockMovementSource", fields: [organizationId, sourceStoreId], references: [organizationId, id], onDelete: Restrict)
  destinationStore   Store?            @relation("StockMovementDestination", fields: [organizationId, destinationStoreId], references: [organizationId, id], onDelete: Restrict)
  createdBy          User              @relation("StockMovementActor", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "stock_movements_organization_id_id_key")
  @@unique([organizationId, createdByUserId, idempotencyKey], map: "stock_movements_org_actor_key_key")
  @@index([organizationId, stockItemId, createdAt, id], map: "stock_movements_org_item_time_idx")
  @@index([organizationId, sourceStoreId, stockItemId], map: "stock_movements_org_source_store_item_idx")
  @@index([organizationId, destinationStoreId, stockItemId], map: "stock_movements_org_destination_store_item_idx")
  @@map("stock_movements")
}

model StockReservation {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  stockItemId       String       @map("stock_item_id") @db.Uuid
  storeId           String       @map("store_id") @db.Uuid
  quantity          Int
  reason            String       @db.VarChar(500)
  createdByUserId   String       @map("created_by_user_id") @db.Uuid
  cancelledByUserId String?      @map("cancelled_by_user_id") @db.Uuid
  cancelledAt       DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  idempotencyKey    String       @map("idempotency_key") @db.VarChar(100)
  payloadHash       String       @map("payload_hash") @db.Char(64)
  version           Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  stockItem         StockItem    @relation(fields: [organizationId, stockItemId], references: [organizationId, id], onDelete: Restrict)
  store             Store        @relation(fields: [organizationId, storeId], references: [organizationId, id], onDelete: Restrict)
  createdBy         User         @relation("StockReservationCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  cancelledBy       User?        @relation("StockReservationCanceller", fields: [organizationId, cancelledByUserId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "stock_reservations_organization_id_id_key")
  @@unique([organizationId, createdByUserId, idempotencyKey], map: "stock_reservations_org_actor_key_key")
  @@index([organizationId, stockItemId, storeId, cancelledAt], map: "stock_reservations_org_item_store_open_idx")
  @@map("stock_reservations")
}

model AssetImportJob {
  id                    String                @id @default(uuid()) @db.Uuid
  organizationId        String                @map("organization_id") @db.Uuid
  createdByUserId       String                @map("created_by_user_id") @db.Uuid
  status                AssetImportStatus     @default(UPLOADED)
  fileChecksum          String                @map("file_checksum") @db.Char(64)
  totalRows             Int                   @default(0) @map("total_rows")
  validRows             Int                   @default(0) @map("valid_rows")
  errorCount            Int                   @default(0) @map("error_count")
  createdCount          Int                   @default(0) @map("created_count")
  previewIdempotencyKey String                @map("preview_idempotency_key") @db.VarChar(100)
  previewPayloadHash    String                @map("preview_payload_hash") @db.Char(64)
  commitIdempotencyKey  String?               @map("commit_idempotency_key") @db.VarChar(100)
  commitPayloadHash     String?               @map("commit_payload_hash") @db.Char(64)
  version               Int                   @default(1)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  committedAt           DateTime?             @map("committed_at") @db.Timestamptz(3)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy             User                  @relation("AssetImportCreator", fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  errors                AssetImportRowError[]

  @@unique([organizationId, id], map: "asset_import_jobs_organization_id_id_key")
  @@unique([organizationId, createdByUserId, previewIdempotencyKey], map: "asset_import_jobs_org_creator_preview_key")
  @@unique([organizationId, createdByUserId, commitIdempotencyKey], map: "asset_import_jobs_org_creator_commit_key")
  @@index([organizationId, createdByUserId, createdAt, id], map: "asset_import_jobs_org_creator_time_idx")
  @@index([organizationId, status, createdAt], map: "asset_import_jobs_org_status_time_idx")
  @@map("asset_import_jobs")
}

model AssetImportRowError {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  importJobId    String         @map("import_job_id") @db.Uuid
  rowNumber      Int            @map("row_number")
  fieldName      String         @map("field_name") @db.VarChar(80)
  code           String         @db.VarChar(50)
  message        String         @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  importJob      AssetImportJob @relation(fields: [organizationId, importJobId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "asset_import_row_errors_organization_id_id_key")
  @@unique([organizationId, importJobId, rowNumber, fieldName, code], map: "asset_import_row_errors_job_row_field_code_key")
  @@index([organizationId, importJobId, rowNumber], map: "asset_import_row_errors_org_job_row_idx")
  @@map("asset_import_row_errors")
}

model Asset {
  id                          String                  @id @default(uuid()) @db.Uuid
  organizationId              String                  @map("organization_id") @db.Uuid
  assetTag                    String                  @map("asset_tag") @db.VarChar(100)
  categoryId                  String                  @map("category_id") @db.Uuid
  manufacturer                String?                 @db.VarChar(150)
  model                       String?                 @db.VarChar(150)
  serialNumber                String?                 @map("serial_number") @db.VarChar(150)
  locationId                  String                  @map("location_id") @db.Uuid
  lifecycle                   AssetLifecycle          @default(RECEIVED)
  availability                AssetAvailability
  condition                   AssetCondition
  verification                AssetVerification       @default(NOT_CHECKED)
  criticality                 AssetCriticality?
  commissioningDate           DateTime?               @map("commissioning_date") @db.Date
  purchaseDate                DateTime?               @map("purchase_date") @db.Date
  warrantyExpiresOn           DateTime?               @map("warranty_expires_on") @db.Date
  warrantyReference           String?                 @map("warranty_reference") @db.VarChar(150)
  sourceReference             String?                 @map("source_reference") @db.VarChar(150)
  notes                       String?                 @db.VarChar(2000)
  specifications              Json?                   @map("specifications")
  version                     Int                     @default(1)
  createdByUserId             String                  @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization                Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category                    AssetCategory           @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  location                    Location                @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  createdBy                   User                    @relation(fields: [organizationId, createdByUserId], references: [organizationId, id], onDelete: Restrict)
  historyEvents               AssetHistoryEvent[]
  parentRelationships         AssetRelationship[]     @relation("AssetRelationshipParent")
  childRelationships          AssetRelationship[]     @relation("AssetRelationshipChild")
  hostComponentInstallations  ComponentInstallation[] @relation("ComponentInstallationHost")
  childComponentInstallations ComponentInstallation[] @relation("ComponentInstallationComponent")
  reservations                AssetReservation[]
  assignments                 AssetAssignment[]
  transferLines               AssetTransferLine[]
  verificationCampaignAssets  VerificationCampaignAsset[]
  observedVerificationObservations VerificationObservation[] @relation("VerificationObservedAsset")
  retirementRequests RetirementRequest[]

  @@unique([organizationId, id], map: "assets_organization_id_id_key")
  @@unique([organizationId, assetTag], map: "assets_organization_id_asset_tag_key")
  @@index([organizationId, createdAt, id], map: "assets_org_created_at_id_idx")
  @@index([organizationId, locationId, createdAt], map: "assets_org_location_created_idx")
  @@index([organizationId, categoryId, createdAt], map: "assets_org_category_created_idx")
  @@index([organizationId, lifecycle, availability], map: "assets_org_lifecycle_availability_idx")
  @@map("assets")
}

model AssetHistoryEvent {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  assetId        String                @map("asset_id") @db.Uuid
  actorUserId    String                @map("actor_user_id") @db.Uuid
  eventType      AssetHistoryEventType @map("event_type")
  details        Json?
  occurredAt     DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  asset          Asset                 @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
