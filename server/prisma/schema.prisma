  publisher                String                           @db.VarChar(150)
  publisherKey             String                           @map("publisher_key") @db.VarChar(150)
  name                     String                           @db.VarChar(150)
  nameKey                  String                           @map("name_key") @db.VarChar(150)
  commercialClassification SoftwareCommercialClassification @map("commercial_classification")
  policyStatus             SoftwarePolicyStatus             @default(REVIEW_REQUIRED) @map("policy_status")
  isActive                 Boolean                          @default(true) @map("is_active")
  version                  Int                              @default(1)
  createdAt                DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization             Organization                     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  editions                 SoftwareEdition[]

  @@unique([organizationId, id], map: "software_products_organization_id_id_key")
  @@unique([organizationId, publisherKey, nameKey], map: "software_products_org_publisher_name_key")
  @@index([organizationId, isActive, nameKey], map: "software_products_org_active_name_idx")
  @@map("software_products")
}

model SoftwareEdition {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  name           String          @db.VarChar(150)
  nameKey        String          @map("name_key") @db.VarChar(150)
  versionLabel   String?         @map("version_label") @db.VarChar(100)
  versionKey     String          @default("") @map("version_key") @db.VarChar(100)
  isActive       Boolean         @default(true) @map("is_active")
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  product        SoftwareProduct @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "software_editions_organization_id_id_key")
  @@unique([organizationId, productId, nameKey, versionKey], map: "software_editions_org_product_name_version_key")
  @@index([organizationId, productId, isActive, nameKey], map: "software_editions_org_product_active_name_idx")
  @@map("software_editions")
}

model Manufacturer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(150)
  nameKey        String       @map("name_key") @db.VarChar(150)
  isActive       Boolean      @default(true) @map("is_active")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  models         AssetModel[]

  @@unique([organizationId, id], map: "manufacturers_organization_id_id_key")
  @@unique([organizationId, nameKey], map: "manufacturers_org_name_key")
  @@index([organizationId, isActive, nameKey], map: "manufacturers_org_active_name_idx")
  @@map("manufacturers")
}

model AssetModel {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  manufacturerId String       @map("manufacturer_id") @db.Uuid
  name           String       @db.VarChar(150)
  nameKey        String       @map("name_key") @db.VarChar(150)
  isActive       Boolean      @default(true) @map("is_active")
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manufacturer   Manufacturer @relation(fields: [organizationId, manufacturerId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id], map: "asset_models_organization_id_id_key")
  @@unique([organizationId, manufacturerId, nameKey], map: "asset_models_org_manufacturer_name_key")
  @@index([organizationId, manufacturerId, isActive, nameKey], map: "asset_models_org_manufacturer_active_idx")
  @@map("asset_models")
}

model Employee {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  employeeNumber String             @map("employee_number") @db.VarChar(150)
  displayName    String             @map("display_name") @db.VarChar(160)
  isActive       Boolean            @default(true) @map("is_active")
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reservations   AssetReservation[]
  assignments    AssetAssignment[]
  verificationObservations VerificationObservation[]

  @@unique([organizationId, id], map: "employees_organization_id_id_key")
  @@unique([organizationId, employeeNumber], map: "employees_organization_id_employee_number_key")
  @@index([organizationId, isActive, displayName], map: "employees_org_active_name_idx")
  @@map("employees")
}
